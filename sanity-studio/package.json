    "migrate:editorial": "sanity exec scripts/migrate-editorial-structure.mjs --with-user-token --"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.12.0",
    "styled-components": "^6.1.15"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "undici": "7.30.0"
    },
    "js-yaml": "3.15.2",
    "adm-zip": "0.6.1",
    "@vercel/frameworks": {
      "smol-toml": "1.8.0"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  }
